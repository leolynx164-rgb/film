bkit-backdrop-filter: blur(20px);\n            border-radius: 16px;\n            padding: 25px;\n            margin-bottom: 20px;\n            border: 1px solid rgba(255, 255, 255, 0.18);\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\n        }\n\n        .config-section h2 {\n            color: #ffffff;\n            font-size: 20px;\n            margin-bottom: 20px;\n            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);\n        }\n\n        .form-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 15px;\n            margin-bottom: 20px;\n        }\n\n        .form-group {\n            margin-bottom: 15px;\n        }\n\n        .form-group.full-width {\n            grid-column: 1 / -1;\n        }\n\n        .form-group label {\n            display: block;\n            color: rgba(255, 255, 255, 0.9);\n            font-size: 13px;\n            font-weight: 600;\n            margin-bottom: 8px;\n            text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            width: 100%;\n            padding: 12px 15px;\n            border: 1px solid rgba(255, 255, 255, 0.3);\n            border-radius: 8px;\n            background: rgba(255, 255, 255, 0.15);\n            backdrop-filter: blur(10px);\n            color: #ffffff;\n            font-size: 14px;\n            outline: none;\n            transition: all 0.3s ease;\n        }\n\n        .form-group textarea {\n            min-height: 100px;\n            resize: vertical;\n            font-family: 'Courier New', monospace;\n        }\n\n        .form-group input::placeholder,\n        .form-group textarea::placeholder {\n            color: rgba(255, 255, 255, 0.5);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            background: rgba(255, 255, 255, 0.2);\n            border-color: rgba(255, 255, 255, 0.5);\n            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);\n        }\n\n        .btn-group {\n            display: flex;\n            gap: 10px;\n            margin-top: 20px;\n        }\n\n        .btn {\n            flex: 1;\n            padding: 12px 24px;\n            border: none;\n            border-radius: 8px;\n            font-size: 15px;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);\n        }\n\n        .btn-primary {\n            background: rgba(76, 175, 80, 0.8);\n            color: white;\n        }\n\n        .btn-primary:hover {\n            background: rgba(76, 175, 80, 1);\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(76, 175, 80, 0.4);\n        }\n\n        .btn-secondary {\n            background: rgba(33, 150, 243, 0.8);\n            color: white;\n        }\n\n        .btn-secondary:hover {\n            background: rgba(33, 150, 243, 1);\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(33, 150, 243, 0.4);\n        }\n\n        .btn-danger {\n            background: rgba(244, 67, 54, 0.8);\n            color: white;\n        }\n\n        .btn-danger:hover {\n            background: rgba(244, 67, 54, 1);\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(244, 67, 54, 0.4);\n        }\n\n        .btn:disabled {\n            opacity: 0.5;\n            cursor: not-allowed;\n            transform: none;\n        }\n\n        .entries-section {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(20px);\n            -webkit-backdrop-filter: blur(20px);\n            border-radius: 16px;\n            padding: 25px;\n            margin-bottom: 20px;\n            border: 1px solid rgba(255, 255, 255, 0.18);\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\n        }\n\n        .entries-section h2 {\n            color: #ffffff;\n            font-size: 20px;\n            margin-bottom: 20px;\n            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);\n        }\n\n        .entry-card {\n            background: rgba(255, 255, 255, 0.15);\n            backdrop-filter: blur(10px);\n            border-radius: 12px;\n            padding: 20px;\n            margin-bottom: 15px;\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            transition: all 0.3s ease;\n        }\n\n        .entry-card:hover {\n            background: rgba(255, 255, 255, 0.2);\n            transform: translateY(-2px);\n            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);\n        }\n\n        .entry-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 10px;\n        }\n\n        .entry-password {\n            color: #ffffff;\n            font-size: 18px;\n            font-weight: 600;\n        }\n\n        .entry-type {\n            display: inline-block;\n            padding: 4px 12px;\n            border-radius: 12px;\n            font-size: 12px;\n            font-weight: 600;\n            text-transform: uppercase;\n        }\n\n        .type-redirect {\n            background: rgba(33, 150, 243, 0.3);\n            color: #ffffff;\n        }\n\n        .type-html {\n            background: rgba(156, 39, 176, 0.3);\n            color: #ffffff;\n        }\n\n        .type-load_html {\n            background: rgba(255, 152, 0, 0.3);\n            color: #ffffff;\n        }\n\n        .entry-info {\n            color: rgba(255, 255, 255, 0.8);\n            font-size: 13px;\n            margin-top: 8px;\n            word-break: break-all;\n        }\n\n        .entry-actions {\n            display: flex;\n            gap: 10px;\n            margin-top: 15px;\n        }\n\n        .btn-small {\n            padding: 6px 16px;\n            font-size: 13px;\n            border: none;\n            border-radius: 6px;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            font-weight: 600;\n        }\n\n        .alert {\n            padding: 15px 20px;\n            border-radius: 8px;\n            margin-bottom: 20px;\n            font-size: 14px;\n            display: none;\n            animation: slideInDown 0.3s ease;\n        }\n\n        .alert.show {\n            display: block;\n        }\n\n        @keyframes slideInDown {\n            from {\n                opacity: 0;\n                transform: translateY(-20px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .alert-success {\n            background: rgba(76, 175, 80, 0.2);\n            border: 1px solid rgba(76, 175, 80, 0.5);\n            color: #ffffff;\n        }\n\n        .alert-error {\n            background: rgba(244, 67, 54, 0.2);\n            border: 1px solid rgba(244, 67, 54, 0.5);\n            color: #ffffff;\n        }\n\n        .alert-info {\n            background: rgba(33, 150, 243, 0.2);\n            border: 1px solid rgba(33, 150, 243, 0.5);\n            color: #ffffff;\n        }\n\n        .loading-overlay {\n            display: none;\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: rgba(0, 0, 0, 0.7);\n            z-index: 9999;\n            justify-content: center;\n            align-items: center;\n        }\n\n        .loading-overlay.show {\n            display: flex;\n        }\n\n        .loading-content {\n            background: rgba(255, 255, 255, 0.95);\n            padding: 40px;\n            border-radius: 16px;\n            text-align: center;\n        }\n\n        .spinner {\n            width: 50px;\n            height: 50px;\n            border: 4px solid rgba(0, 0, 0, 0.1);\n            border-top-color: #4CAF50;\n            border-radius: 50%;\n            animation: spin 1s linear infinite;\n            margin: 0 auto 20px;\n        }\n\n        @keyframes spin {\n            to { transform: rotate(360deg); }\n        }\n\n        .loading-text {\n            color: #333;\n            font-size: 16px;\n            font-weight: 600;\n        }\n\n        .html-editor {\n            display: none;\n        }\n\n        .html-editor.show {\n            display: block;\n        }\n\n        select {\n            cursor: pointer;\n        }\n\n        select option {\n            background: #333;\n            color: white;\n        }\n\n        .auto-save-toggle {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n            color: rgba(255, 255, 255, 0.9);\n            font-size: 14px;\n            margin-top: 10px;\n        }\n\n        .toggle-switch {\n            position: relative;\n            width: 50px;\n            height: 24px;\n            background: rgba(255, 255, 255, 0.2);\n            border-radius: 12px;\n            cursor: pointer;\n            transition: background 0.3s;\n        }\n\n        .toggle-switch.active {\n            background: rgba(76, 175, 80, 0.8);\n        }\n\n        .toggle-slider {\n            position: absolute;\n            top: 2px;\n            left: 2px;\n            width: 20px;\n            height: 20px;\n            background: white;\n            border-radius: 50%;\n            transition: transform 0.3s;\n        }\n\n        .toggle-switch.active .toggle-slider {\n            transform: translateX(26px);\n        }\n    </style>\n</head>\n<body>\n    <div class=\"admin-container\">\n        <div class=\"header\">\n            <h1>🔐 LEO PASSWORD - Admin Panel</h1>\n            <p>Gestion des mots de passe et des sites</p>\n        </div>\n\n        <div id=\"alertContainer\"></div>\n\n        <!-- Configuration GitHub -->\n        <div class=\"config-section\">\n            <h2>⚙️ Configuration GitHub</h2>\n            <div class=\"form-grid\">\n                <div class=\"form-group\">\n                    <label>GitHub Token</label>\n                    <input type=\"password\" id=\"githubToken\" placeholder=\"ghp_xxxxxxxxxxxxx\">\n                </div>\n                <div class=\"form-group\">\n                    <label>Nom du repository</label>\n                    <input type=\"text\" id=\"repoName\" placeholder=\"username/repository\" value=\"leolynx164-rgb/film\">\n                </div>\n                <div class=\"form-group\">\n                    <label>Branche</label>\n                    <input type=\"text\" id=\"branchName\" placeholder=\"contactForm\" value=\"contactForm\">\n                </div>\n                <div class=\"form-group\">\n                    <label>Chemin du fichier JSON</label>\n                    <input type=\"text\" id=\"filePath\" placeholder=\"mot-de-passe.json\" value=\"mot-de-passe.json\">\n                </div>\n            </div>\n            <div class=\"auto-save-toggle\">\n                <div class=\"toggle-switch\" id=\"autoSaveToggle\" onclick=\"toggleAutoSave()\">\n                    <div class=\"toggle-slider\"></div>\n                </div>\n                <span>Sauvegarde automatique sur GitHub</span>\n            </div>\n            <div class=\"btn-group\">\n                <button class=\"btn btn-secondary\" onclick=\"loadFromGitHub()\">📥 Charger depuis GitHub</button>\n                <button class=\"btn btn-primary\" onclick=\"saveToGitHub()\">💾 Sauvegarder manuellement</button>\n            </div>\n        </div>\n\n        <!-- Ajouter une nouvelle entrée -->\n        <div class=\"config-section\">\n            <h2>➕ Ajouter une nouvelle entrée</h2>\n            <div class=\"form-grid\">\n                <div class=\"form-group\">\n                    <label>Mot de passe</label>\n                    <input type=\"text\" id=\"newPassword\" placeholder=\"motdepasse123\">\n                </div>\n                <div class=\"form-group\">\n                    <label>Type</label>\n                    <select id=\"newType\" onchange=\"handleTypeChange()\">\n                        <option value=\"redirect\">Redirection URL</option>\n                        <option value=\"html\">Code HTML</option>\n                        <option value=\"load_html\">Charger HTML depuis URL</option>\n                    </select>\n                </div>\n            </div>\n            \n            <div class=\"form-group full-width\" id=\"redirectInput\">\n                <label>URL de redirection</label>\n                <input type=\"text\" id=\"newRedirect\" placeholder=\"https://exemple.com\">\n            </div>\n\n            <div class=\"form-group full-width html-editor\" id=\"htmlInput\">\n                <label>Code HTML complet</label>\n                <textarea id=\"newHtml\" placeholder=\"<!DOCTYPE html>...\"></textarea>\n            </div>\n\n            <div class=\"form-group full-width html-editor\" id=\"loadHtmlInput\">\n                <label>URL du fichier HTML</label>\n                <input type=\"text\" id=\"newLoadHtml\" placeholder=\"https://exemple.com/page.html\">\n            </div>\n\n            <div class=\"btn-group\">\n                <button class=\"btn btn-primary\" onclick=\"addEntry()\">➕ Ajouter et Sauvegarder</button>\n            </div>\n        </div>\n\n        <!-- Liste des entrées -->\n        <div class=\"entries-section\">\n            <h2>📋 Entrées existantes (<span id=\"entryCount\">0</span>)</h2>\n            <div id=\"entriesList\"></div>\n        </div>\n    </div>\n\n    <!-- Loading overlay -->\n    <div class=\"loading-overlay\" id=\"loadingOverlay\">\n        <div class=\"loading-content\">\n            <div class=\"spinner\"></div>\n            <div class=\"loading-text\" id=\"loadingText\">Chargement...</div>\n        </div>\n    </div>\n\n    <script>\n        let currentData = [];\n        let fileSha = null;\n        let autoSave = true; // Activé par défaut\n\n        // Charger les préférences depuis localStorage\n        function loadPreferences() {\n            const savedToken = localStorage.getItem('githubToken');\n            const savedAutoSave = localStorage.getItem('autoSave');\n            \n            if (savedToken) {\n                document.getElementById('githubToken').value = savedToken;\n            }\n            \n            if (savedAutoSave !== null) {\n                autoSave = savedAutoSave === 'true';\n                updateAutoSaveUI();\n            } else {\n                updateAutoSaveUI();\n            }\n        }\n\n        // Sauvegarder les préférences\n        function savePreferences() {\n            const token = document.getElementById('githubToken').value.trim();\n            if (token) {\n                localStorage.setItem('githubToken', token);\n            }\n            localStorage.setItem('autoSave', autoSave.toString());\n        }\n\n        // Toggle auto-save\n        function toggleAutoSave() {\n            autoSave = !autoSave;\n            updateAutoSaveUI();\n            savePreferences();\n            showAlert(autoSave ? '✓ Sauvegarde automatique activée' : '⚠️ Sauvegarde automatique désactivée', 'info');\n        }\n\n        function updateAutoSaveUI() {\n            const toggle = document.getElementById('autoSaveToggle');\n            if (autoSave) {\n                toggle.classList.add('active');\n            } else {\n                toggle.classList.remove('active');\n            }\n        }\n\n        // Afficher une alerte\n        function showAlert(message, type = 'info') {\n            const alertContainer = document.getElementById('alertContainer');\n            const alert = document.createElement('div');\n            alert.className = `alert alert-${type} show`;\n            alert.textContent = message;\n            alertContainer.appendChild(alert);\n\n            setTimeout(() => {\n                alert.classList.remove('show');\n                setTimeout(() => alert.remove(), 300);\n            }, 5000);\n        }\n\n        // Afficher/masquer le loading\n        function showLoading(show, text = 'Chargement...') {\n            const overlay = document.getElementById('loadingOverlay');\n            const loadingText = document.getElementById('loadingText');\n            loadingText.textContent = text;\n            if (show) {\n                overlay.classList.add('show');\n            } else {\n                overlay.classList.remove('show');\n            }\n        }\n\n        // Gérer le changement de type\n        function handleTypeChange() {\n            const type = document.getElementById('newType').value;\n            document.getElementById('redirectInput').style.display = type === 'redirect' ? 'block' : 'none';\n            document.getElementById('htmlInput').classList.toggle('show', type === 'html');\n            document.getElementById('loadHtmlInput').classList.toggle('show', type === 'load_html');\n        }\n\n        // Charger depuis GitHub\n        async function loadFromGitHub() {\n            const token = document.getElementById('githubToken').value.trim();\n            const repo = document.getElementById('repoName').value.trim();\n            const branch = document.getElementById('branchName').value.trim();\n            const path = document.getElementById('filePath').value.trim();\n\n            if (!token || !repo || !branch || !path) {\n                showAlert('Veuillez remplir tous les champs de configuration', 'error');\n                return;\n            }\n\n            savePreferences();\n            showLoading(true, 'Chargement depuis GitHub...');\n\n            try {\n                const url = `https://api.github.com/repos/${repo}/contents/${path}?ref=${branch}`;\n                const response = await fetch(url, {\n                    headers: {\n                        'Authorization': `token ${token}`,\n                        'Accept': 'application/vnd.github.v3+json'\n                    }\n                });\n\n                if (!response.ok) {\n                    throw new Error(`Erreur ${response.status}: ${response.statusText}`);\n                }\n\n                const data = await response.json();\n                fileSha = data.sha;\n                \n                const content = atob(data.content);\n                currentData = JSON.parse(content);\n                \n                displayEntries();\n                showAlert('✓ Données chargées depuis GitHub avec succès !', 'success');\n            } catch (error) {\n                console.error('Erreur:', error);\n                showAlert('Erreur lors du chargement: ' + error.message, 'error');\n            } finally {\n                showLoading(false);\n            }\n        }\n\n        // Sauvegarder sur GitHub\n        async function saveToGitHub() {\n            const token = document.getElementById('githubToken').value.trim();\n            const repo = document.getElementById('repoName').value.trim();\n            const branch = document.getElementById('branchName').value.trim();\n            const path = document.getElementById('filePath').value.trim();\n\n            if (!token || !repo || !branch || !path) {\n                showAlert('Veuillez remplir tous les champs de configuration', 'error');\n                return;\n            }\n\n            if (currentData.length === 0) {\n                showAlert('Aucune donnée à sauvegarder', 'error');\n                return;\n            }\n\n            savePreferences();\n            showLoading(true, 'Sauvegarde sur GitHub...');\n\n            try {\n                const content = JSON.stringify(currentData, null, 2);\n                const contentBase64 = btoa(unescape(encodeURIComponent(content)));\n\n                const url = `https://api.github.com/repos/${repo}/contents/${path}`;\n                const payload = {\n                    message: `Update passwords - ${new Date().toISOString()}`,\n                    content: contentBase64,\n                    branch: branch\n                };\n\n                if (fileSha) {\n                    payload.sha = fileSha;\n                }\n\n                const response = await fetch(url, {\n                    method: 'PUT',\n                    headers: {\n                        'Authorization': `token ${token}`,\n                        'Accept': 'application/vnd.github.v3+json',\n                        'Content-Type': 'application/json'\n                    },\n                    body: JSON.stringify(payload)\n                });\n\n                if (!response.ok) {\n                    const errorData = await response.json();\n                    throw new Error(errorData.message || `Erreur ${response.status}`);\n                }\n\n                const result = await response.json();\n                fileSha = result.content.sha;\n                \n                showAlert('✓ Données sauvegardées sur GitHub avec succès !', 'success');\n                return true;\n            } catch (error) {\n                console.error('Erreur:', error);\n                showAlert('Erreur lors de la sauvegarde: ' + error.message, 'error');\n                return false;\n            } finally {\n                showLoading(false);\n            }\n        }\n\n        // Ajouter une entrée\n        async function addEntry() {\n            const password = document.getElementById('newPassword').value.trim();\n            const type = document.getElementById('newType').value;\n\n            if (!password) {\n                showAlert('Veuillez entrer un mot de passe', 'error');\n                return;\n            }\n\n            // Vérifier si le mot de passe existe déjà\n            if (currentData.some(entry => entry.password === password)) {\n                showAlert('Ce mot de passe existe déjà !', 'error');\n                return;\n            }\n\n            const newEntry = { password, type };\n\n            switch(type) {\n                case 'redirect':\n                    const redirect = document.getElementById('newRedirect').value.trim();\n                    if (!redirect) {\n                        showAlert('Veuillez entrer une URL de redirection', 'error');\n                        return;\n                    }\n                    newEntry.redirect = redirect;\n                    break;\n\n                case 'html':\n                    const html = document.getElementById('newHtml').value.trim();\n                    if (!html) {\n                        showAlert('Veuillez entrer le code HTML', 'error');\n                        return;\n                    }\n                    newEntry.html = html;\n                    break;\n\n                case 'load_html':\n                    const url = document.getElementById('newLoadHtml').value.trim();\n                    if (!url) {\n                        showAlert('Veuillez entrer une URL', 'error');\n                        return;\n                    }\n                    newEntry.url = url;\n                    break;\n            }\n\n            currentData.push(newEntry);\n            displayEntries();\n            clearForm();\n            \n            // Sauvegarder automatiquement si activé\n            if (autoSave) {\n                const success = await saveToGitHub();\n                if (success) {\n                    showAlert('✓ Entrée ajoutée et sauvegardée sur GitHub !', 'success');\n                } else {\n                    showAlert('⚠️ Entrée ajoutée mais erreur lors de la sauvegarde', 'error');\n                }\n            } else {\n                showAlert('✓ Entrée ajoutée ! N\\'oubliez pas de sauvegarder manuellement.', 'info');\n            }\n        }\n\n        // Supprimer une entrée\n        async function deleteEntry(index) {\n            if (confirm('Êtes-vous sûr de vouloir supprimer cette entrée ?')) {\n                currentData.splice(index, 1);\n                displayEntries();\n                \n                // Sauvegarder automatiquement si activé\n                if (autoSave) {\n                    const success = await saveToGitHub();\n                    if (success) {\n                        showAlert('✓ Entrée supprimée et sauvegardée sur GitHub !', 'success');\n                    }\n                } else {\n                    showAlert('✓ Entrée supprimée ! N\\'oubliez pas de sauvegarder manuellement.', 'info');\n                }\n            }\n        }\n\n        // Afficher les entrées\n        function displayEntries() {\n            const container = document.getElementById('entriesList');\n            const countElement = document.getElementById('entryCount');\n            \n            countElement.textContent = currentData.length;\n\n            if (currentData.length === 0) {\n                container.innerHTML = '<p style=\"color: rgba(255,255,255,0.7); text-align: center; padding: 20px;\">Aucune entrée. Chargez depuis GitHub ou ajoutez-en une nouvelle.</p>';\n                return;\n            }\n\n            container.innerHTML = currentData.map((entry, index) => {\n                let info = '';\n                if (entry.redirect) info = `🔗 ${entry.redirect}`;\n                else if (entry.html) info = `📄 Code HTML (${entry.html.length} caractères)`;\n                else if (entry.url) info = `🌐 ${entry.url}`;\n\n                return `\n                    <div class=\"entry-card\">\n                        <div class=\"entry-header\">\n                            <span class=\"entry-password\">🔑 ${entry.password}</span>\n                            <span class=\"entry-type type-${entry.type}\">${entry.type}</span>\n                        </div>\n                        <div class=\"entry-info\">${info}</div>\n                        <div class=\"entry-actions\">\n                            <button class=\"btn-small btn-danger\" onclick=\"deleteEntry(${index})\">🗑️ Supprimer</button>\n                        </div>\n                    </div>\n                `;\n            }).join('');\n        }\n\n        // Réinitialiser le formulaire\n        function clearForm() {\n            document.getElementById('newPassword').value = '';\n            document.getElementById('newRedirect').value = '';\n            document.getElementById('newHtml').value = '';\n            document.getElementById('newLoadHtml').value = '';\n            document.getElementById('newType').value = 'redirect';\n            handleTypeChange();\n        }\n\n        // Initialisation\n        loadPreferences();\n        handleTypeChange();\n        displayEntries();\n    </script>\n</body>\n</html>"
  }
]