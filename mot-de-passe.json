    "html": "\n<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Leo Password - AccÃÂÃÂ¨s SÃÂÃÂ©curisÃÂÃÂ©</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n            min-height: 100vh;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            background: url('https://www.blog-le-dessin.com/wp-content/uploads/2023/03/abstrait-marblage-6d3e62d6-48b3-4f84-b3e7-23506a16c5c8-1024x1024.jpg') no-repeat center center;\n            background-size: cover;\n            position: relative;\n            overflow: hidden;\n        }\n\n        body::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: rgba(0, 0, 0, 0.3);\n        }\n\n        .container {\n            position: relative;\n            z-index: 1;\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(20px);\n            -webkit-backdrop-filter: blur(20px);\n            border-radius: 24px;\n            padding: 50px 40px;\n            width: 500px;\n            box-shadow: \n                0 8px 32px rgba(0, 0, 0, 0.3),\n                inset 0 1px 0 rgba(255, 255, 255, 0.2);\n            border: 1px solid rgba(255, 255, 255, 0.18);\n            animation: slideIn 0.6s ease-out;\n        }\n\n        @keyframes slideIn {\n            from {\n                opacity: 0;\n                transform: translateY(-30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .logo-section {\n            text-align: center;\n            margin-bottom: 40px;\n        }\n\n        .logo-title {\n            color: #ffffff;\n            font-size: 36px;\n            font-weight: 700;\n            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);\n            margin-bottom: 8px;\n            letter-spacing: 1px;\n        }\n\n        .logo-subtitle {\n            color: rgba(255, 255, 255, 0.8);\n            font-size: 14px;\n            font-weight: 400;\n        }\n\n        /* Section de chargement */\n        .loading-section {\n            text-align: center;\n        }\n\n        .loading-section.hidden {\n            display: none;\n        }\n\n        .loading-text {\n            color: #ffffff;\n            font-size: 16px;\n            margin-bottom: 25px;\n            min-height: 24px;\n            text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);\n            animation: pulse 1.5s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0.6; }\n        }\n\n        /* Animation du cadenas */\n        .lock-container {\n            margin: 30px 0;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            height: 120px;\n        }\n\n        .lock-icon {\n            font-size: 80px;\n            color: #ffffff;\n            text-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);\n            animation: lockShake 0.5s ease-in-out;\n        }\n\n        .lock-icon.unlocking {\n            animation: unlockAnimation 1s ease-in-out forwards;\n        }\n\n        @keyframes lockShake {\n            0%, 100% { transform: rotate(0deg); }\n            25% { transform: rotate(-5deg); }\n            75% { transform: rotate(5deg); }\n        }\n\n        @keyframes unlockAnimation {\n            0% {\n                transform: rotate(0deg) scale(1);\n                opacity: 1;\n            }\n            50% {\n                transform: rotate(15deg) scale(1.1);\n            }\n            100% {\n                transform: rotate(0deg) scale(1.2);\n                opacity: 0.3;\n            }\n        }\n\n        /* Barre de progression */\n        .progress-bar-container {\n            width: 100%;\n            height: 8px;\n            background: rgba(255, 255, 255, 0.2);\n            border-radius: 10px;\n            overflow: hidden;\n            margin-top: 20px;\n        }\n\n        .progress-bar {\n            height: 100%;\n            background: linear-gradient(90deg, #4CAF50, #45a049);\n            border-radius: 10px;\n            width: 0%;\n            transition: width 0.3s ease;\n            box-shadow: 0 0 10px rgba(76, 175, 80, 0.5);\n        }\n\n        /* Section des informations */\n        .info-section {\n            display: none;\n            animation: fadeInUp 0.6s ease-out;\n        }\n\n        .info-section.show {\n            display: block;\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(20px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .success-icon {\n            text-align: center;\n            font-size: 60px;\n            margin-bottom: 20px;\n            animation: scaleIn 0.5s ease-out;\n        }\n\n        @keyframes scaleIn {\n            from {\n                transform: scale(0);\n                opacity: 0;\n            }\n            to {\n                transform: scale(1);\n                opacity: 1;\n            }\n        }\n\n        .info-title {\n            color: #ffffff;\n            font-size: 24px;\n            font-weight: 600;\n            text-align: center;\n            margin-bottom: 30px;\n            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);\n        }\n\n        .info-card {\n            background: rgba(255, 255, 255, 0.15);\n            backdrop-filter: blur(10px);\n            border-radius: 12px;\n            padding: 20px;\n            margin-bottom: 15px;\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            transition: all 0.3s ease;\n        }\n\n        .info-card:hover {\n            background: rgba(255, 255, 255, 0.2);\n            transform: translateY(-2px);\n            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);\n        }\n\n        .info-label {\n            color: rgba(255, 255, 255, 0.8);\n            font-size: 12px;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n            margin-bottom: 8px;\n        }\n\n        .info-value {\n            color: #ffffff;\n            font-size: 16px;\n            font-weight: 500;\n            word-break: break-all;\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n        }\n\n        .copy-btn {\n            background: rgba(76, 175, 80, 0.8);\n            border: none;\n            color: white;\n            padding: 6px 12px;\n            border-radius: 6px;\n            cursor: pointer;\n            font-size: 12px;\n            font-weight: 600;\n            transition: all 0.3s ease;\n            margin-left: 10px;\n            white-space: nowrap;\n        }\n\n        .copy-btn:hover {\n            background: rgba(76, 175, 80, 1);\n            transform: scale(1.05);\n        }\n\n        .copy-btn:active {\n            transform: scale(0.95);\n        }\n\n        .copy-btn.copied {\n            background: rgba(33, 150, 243, 0.8);\n        }\n\n        .access-btn {\n            width: 100%;\n            padding: 14px;\n            border: none;\n            border-radius: 12px;\n            background: rgba(60, 60, 60, 0.8);\n            color: #ffffff;\n            font-size: 16px;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);\n            margin-top: 20px;\n        }\n\n        .access-btn:hover {\n            background: rgba(80, 80, 80, 0.9);\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);\n        }\n\n        .access-btn:active {\n            transform: translateY(0);\n        }\n\n        .note {\n            margin-top: 20px;\n            padding: 15px;\n            background: rgba(255, 152, 0, 0.15);\n            border-left: 4px solid rgba(255, 152, 0, 0.6);\n            border-radius: 8px;\n            color: rgba(255, 255, 255, 0.9);\n            font-size: 13px;\n            line-height: 1.6;\n        }\n\n        .note strong {\n            color: #ffffff;\n        }\n\n        /* Animation des particules */\n        .particle {\n            position: absolute;\n            width: 4px;\n            height: 4px;\n            background: rgba(255, 255, 255, 0.6);\n            border-radius: 50%;\n            pointer-events: none;\n            animation: float 3s ease-in-out infinite;\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translateY(0) translateX(0);\n                opacity: 0;\n            }\n            50% {\n                opacity: 1;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"logo-section\">\n            <div class=\"logo-title\">LEO PASSWORD</div>\n            <div class=\"logo-subtitle\">SystÃÂÃÂ¨me de gestion sÃÂÃÂ©curisÃÂÃÂ©e</div>\n        </div>\n\n        <!-- Section de chargement -->\n        <div class=\"loading-section\" id=\"loadingSection\">\n            <div class=\"loading-text\" id=\"loadingText\">Initialisation...</div>\n            <div class=\"lock-container\">\n                <div class=\"lock-icon\" id=\"lockIcon\">ÃÂ°ÃÂÃÂÃÂ</div>\n            </div>\n            <div class=\"progress-bar-container\">\n                <div class=\"progress-bar\" id=\"progressBar\"></div>\n            </div>\n        </div>\n\n        <!-- Section des informations -->\n        <div class=\"info-section\" id=\"infoSection\">\n            <div class=\"success-icon\">ÃÂ¢ÃÂÃÂ</div>\n            <div class=\"info-title\">AccÃÂÃÂ¨s DÃÂÃÂ©verrouillÃÂÃÂ©</div>\n\n            <div class=\"info-card\">\n                <div class=\"info-label\">Identifiant</div>\n                <div class=\"info-value\">\n                    <span id=\"emailValue\">renagel590@dnsclick.com</span>\n                    <button class=\"copy-btn\" onclick=\"copyToClipboard('emailValue', this)\">Copier</button>\n                </div>\n            </div>\n\n            <div class=\"info-card\">\n                <div class=\"info-label\">Mot de passe</div>\n                <div class=\"info-value\">\n                    <span id=\"passwordValue\">renagel590@dnsclick.com</span>\n                    <button class=\"copy-btn\" onclick=\"copyToClipboard('passwordValue', this)\">Copier</button>\n                </div>\n            </div>\n\n            <div class=\"info-card\">\n                <div class=\"info-label\">URL d'accÃÂÃÂ¨s</div>\n                <div class=\"info-value\">\n                    <span id=\"urlValue\">https://college-vert.base44.app/</span>\n                    <button class=\"copy-btn\" onclick=\"copyToClipboard('urlValue', this)\">Copier</button>\n                </div>\n            </div>\n\n            <button class=\"access-btn\" onclick=\"goToUrl()\">AccÃÂÃÂ©der au site</button>\n\n            <div class=\"note\">\n                <strong>ÃÂ¢ÃÂÃÂ ÃÂ¯ÃÂ¸ÃÂ Compte temporaire</strong><br>\n                Ces identifiants sont valables pour une session limitÃÂÃÂ©e. Veuillez les utiliser immÃÂÃÂ©diatement et ne pas les partager.\n            </div>\n        </div>\n    </div>\n\n    <script>\n        const loadingSteps = [\n            { text: \"Leo Password : CrÃÂÃÂ©ation d'un compte temporaire...\", duration: 3000 },\n            { text: \"DÃÂÃÂ©verrouillage de votre casier cryptÃÂÃÂ©...\", duration: 3000 }\n        ];\n\n        let currentStep = 0;\n        let progress = 0;\n\n        function updateProgress(targetProgress, duration) {\n            const startProgress = progress;\n            const progressDiff = targetProgress - startProgress;\n            const startTime = Date.now();\n\n            function animate() {\n                const elapsed = Date.now() - startTime;\n                const progressPercent = Math.min(elapsed / duration, 1);\n                \n                progress = startProgress + (progressDiff * progressPercent);\n                document.getElementById('progressBar').style.width = progress + '%';\n\n                if (progressPercent < 1) {\n                    requestAnimationFrame(animate);\n                }\n            }\n\n            animate();\n        }\n\n        function createParticles() {\n            const container = document.querySelector('.lock-container');\n            for (let i = 0; i < 15; i++) {\n                setTimeout(() => {\n                    const particle = document.createElement('div');\n                    particle.className = 'particle';\n                    particle.style.left = '50%';\n                    particle.style.top = '50%';\n                    particle.style.animationDelay = Math.random() * 0.5 + 's';\n                    particle.style.animationDuration = (Math.random() * 2 + 2) + 's';\n                    \n                    const angle = Math.random() * Math.PI * 2;\n                    const distance = Math.random() * 100 + 50;\n                    particle.style.setProperty('--tx', Math.cos(angle) * distance + 'px');\n                    particle.style.setProperty('--ty', Math.sin(angle) * distance + 'px');\n                    \n                    container.appendChild(particle);\n                    \n                    setTimeout(() => particle.remove(), 3000);\n                }, i * 100);\n            }\n        }\n\n        async function startLoading() {\n            for (let i = 0; i < loadingSteps.length; i++) {\n                const step = loadingSteps[i];\n                document.getElementById('loadingText').textContent = step.text;\n                \n                // Animation spÃÂÃÂ©ciale pour le dÃÂÃÂ©verrouillage\n                if (i === 1) {\n                    setTimeout(() => {\n                        document.getElementById('lockIcon').classList.add('unlocking');\n                        createParticles();\n                        setTimeout(() => {\n                            document.getElementById('lockIcon').textContent = 'ÃÂ°ÃÂÃÂÃÂ';\n                        }, 500);\n                    }, 500);\n                }\n\n                const targetProgress = ((i + 1) / loadingSteps.length) * 100;\n                updateProgress(targetProgress, step.duration);\n                \n                await new Promise(resolve => setTimeout(resolve, step.duration));\n            }\n\n            // Afficher les informations\n            setTimeout(() => {\n                document.getElementById('loadingSection').classList.add('hidden');\n                document.getElementById('infoSection').classList.add('show');\n            }, 500);\n        }\n\n        function copyToClipboard(elementId, button) {\n            const text = document.getElementById(elementId).textContent;\n            navigator.clipboard.writeText(text).then(() => {\n                const originalText = button.textContent;\n                button.textContent = 'ÃÂ¢ÃÂÃÂ CopiÃÂÃÂ©';\n                button.classList.add('copied');\n                \n                setTimeout(() => {\n                    button.textContent = originalText;\n                    button.classList.remove('copied');\n                }, 2000);\n            }).catch(err => {\n                console.error('Erreur de copie:', err);\n                alert('Erreur lors de la copie');\n            });\n        }\n\n        function goToUrl() {\n            window.location.href = 'https://college-vert.base44.app/';\n        }\n\n        // DÃÂÃÂ©marrer le chargement au chargement de la page\n        window.addEventListener('load', startLoading);\n    </script>\n</body>\n</html>"
